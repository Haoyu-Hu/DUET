# Python build / cache (also leaks absolute source paths via .pyc co_filename)
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/

# Jupyter / IDE caches
.ipynb_checkpoints/
.vscode/
.idea/

# Virtual environments
venv/
.venv/
env/

# Local-build artifacts (regenerated by scripts/setup/* — should not be tracked)
datasets/
model_checkpoints/
experiments/
verl_workspace/
outputs/

# Logs and runtime droppings
*.log
*.pid
*.swp
.DS_Store

# Secrets / credentials — defensive; refuse to ever track
.env
.env.*
*.pem
*.key
credentials.json
.netrc
.huggingface/
